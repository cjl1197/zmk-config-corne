/* Target the core system pin-controller directly to route our physical hardware lines */
&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,  /* P0.00 maps to your MOSI wire */
                    <NRF_PSEL(TWIM_SCL, 0, 11)>; /* P0.11 maps to your SCK wire */
            bias-pull-up;
        };
    };

    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 11)>;
            low-power-enable;
        };
    };
};

/* Activate the second hardware I2C controller and mount a standard OLED on it */
&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    /* Tell ZMK there is a standard 128x32 SSD1306 screen sitting here */
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
    };
};
