/* Explicitly disable the stock default display node from the base Corne shield */
&oled {
    status = "disabled";
};

/* Target the core system pin-controller directly to inject our I2C alternate functions */
&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,  /* P0.00 / MOSI Pad */
                    <NRF_PSEL(TWIM_SCL, 0, 11)>; /* P0.11 / SCK Pad */
            bias-pull-up;
        };
    };

    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 11)>;
            low-power-enable;
        };
    };
};

/* Initialize our custom I2C master engine on those mapped lines */
&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    custom_oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        
        /* Required Zephyr 4.1 hardware configuration properties */
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        
        /* Traditional empty boolean flags for the schema parser */
        segment-remap;
        com-invdir;
        com-sequential;
    };
};
